;; DNS records for elsgroupllc.com — GitHub Pages
;; Import via Cloudflare: DNS -> Records -> Import and Export -> Import DNS records.
;; IMPORTANT: leave "Proxy imported DNS records" UNCHECKED so records import as
;; "DNS only" (grey cloud) — GitHub cannot issue the HTTPS cert through the proxy.
;; TTL 1 = "Auto" in Cloudflare.

;; A Records (GitHub Pages apex IPs)
elsgroupllc.com.	1	IN	A	185.199.108.153
elsgroupllc.com.	1	IN	A	185.199.109.153
elsgroupllc.com.	1	IN	A	185.199.110.153
elsgroupllc.com.	1	IN	A	185.199.111.153

;; CNAME Records
www.elsgroupllc.com.	1	IN	CNAME	sbstevens14.github.io.

;; TXT Records (email spoofing policy — MX/SPF/DKIM are Cloudflare Email
;; Routing-managed and not included here)
;; p=none is monitor-only; tighten to p=quarantine after reports look clean.
_dmarc.elsgroupllc.com.	1	IN	TXT	"v=DMARC1; p=none; rua=mailto:sbstevens14@gmail.com"
